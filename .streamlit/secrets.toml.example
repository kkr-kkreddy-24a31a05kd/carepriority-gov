# CarePriority Gov - Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml for local development or paste into
# Streamlit Community Cloud (App Settings -> Secrets).
#
# NOTE: MongoDB is completely optional. If MONGO_URI is omitted or unreachable,
# CarePriority Gov runs automatically in in-memory session mode.
# NEVER commit real credentials to GitHub.

MONGO_URI = "mongodb+srv://<username>:<password>@<cluster-address>/<database>?retryWrites=true&w=majority"
DB_NAME = "carepriority_gov"
